# --- Base de datos (PostgreSQL) ---
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=recon
DB_PASSWORD=recon
DB_NAME=recon
# true solo en desarrollo; en producción usar migraciones
DB_SYNC=true

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Clave de la plataforma para crear tenants (header x-platform-key)
PLATFORM_ADMIN_KEY=cambia-esta-clave-de-plataforma

# --- Ledger ---
# memory = ledger de partida doble en memoria (desarrollo / pruebas)
# formance = Formance Ledger vía HTTP
LEDGER_DRIVER=memory
FORMANCE_URL=http://localhost:3068

PORT=3000

# --- Scheduler de reconciliación ---
RECON_CRON_ENABLED=false
RECON_CRON_INTERVAL_MS=3600000
RECON_CRON_WINDOW_HOURS=24
